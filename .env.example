# Required (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
# Alternative name also supported by lib/env.ts:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (account deletion, OpenAI key storage)
SUPABASE_SERVICE_ROLE_KEY=

# App URL (OAuth redirects, links)
NEXT_PUBLIC_APP_URL=

# Optional — AI product shots (POST /api/generate-shot)
FAL_API_KEY=

# Optional — override Shopify OAuth callback URL if not derived from NEXT_PUBLIC_APP_URL
SHOPIFY_OAUTH_REDIRECT_URI=

# Key used to encrypt/decrypt sensitive data in the database (e.g. OpenAI keys, Shopify tokens)
ENCRYPTION_KEY=